rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection rules
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Jobs Collection rules
    match /jobs/{jobId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if (request.auth != null && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
    }

    // CreditTransactions Collection rules
    match /creditTransactions/{transactionId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, write: if (request.auth != null && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
    }

    // Detections Collection rules
    match /detections/{detectionId} {
      allow create: if false; // Created via Cloud Functions
      allow read, update, delete: if (request.auth != null && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
    }

    // API Keys Collection rules
    match /apiKeys/{keyId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Voice Profiles Collection rules
    match /voiceProfiles/{profileId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
